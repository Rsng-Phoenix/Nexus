{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "NEXUS", "weight": "Bolder", "size": "Small", "isSubtle": true },
    {
      "type": "ColumnSet",
      "$data": "${rows}",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column", "width": "stretch", "$data": "${cells}", "style": "emphasis",
          "selectAction": { "type": "Action.Execute", "verb": "quadrant", "data": { "priority": "${priority}" } },
          "items": [
            { "type": "ColumnSet", "columns": [
              { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${label}", "weight": "Bolder", "color": "${color}" } ] },
              { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "${count}", "weight": "Bolder" } ] }
            ] },
            { "type": "TextBlock", "text": "${top1}", "size": "Small", "wrap": false, "maxLines": 1, "spacing": "Small" },
            { "type": "TextBlock", "text": "${top2}", "size": "Small", "wrap": false, "maxLines": 1, "spacing": "None", "isSubtle": true }
          ]
        }
      ]
    }
  ],
  "actions": [ { "type": "Action.Execute", "title": "New task", "verb": "add" } ]
}
